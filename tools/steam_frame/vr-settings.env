# Settings of the VR mode on the Steam Frame, read by LAUNCH-STEAM-FRAME.sh at every launch.
# One NAME=value a line. The README lists every DEVILUTIONX_VR_ variable and its default.
# deploy.sh copies this file to the Frame's data folder once and leaves an existing one alone.

# Snap turn in degrees. The game's own default is 45.
DEVILUTIONX_VR_SNAP_TURN=30
